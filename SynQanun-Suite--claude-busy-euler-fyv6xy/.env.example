# SynQanun Suite — environment variables
#
# NOTHING BELOW IS READ BY TRACK A. The prototype runs with no .env at all:
# every integration is faked behind lib/mock-api.ts. This file documents the
# shape of the eventual configuration, nothing more.
#
# Variables are grouped by WHICH TRACK turns them real, because the plan splits
# that work between two different sets of hands (BUILD_PLAN.md §"Three tracks"):
#
#   Track A.5 — still solo. Database, real authentication, real CRUD routes,
#               and real LLM calls. Achievable with an API key and a Postgres
#               instance; no third-party approval needed.
#   Track B   — dev team. Third-party integrations whose real API access is
#               gated on provider business verification and security review,
#               which is why they are not attempted solo — the delay is
#               procedural, not a coding problem.
#
# BUILD_PLAN.md §7 expects that by the end of Track A.5 the LLM key is real and
# in use, and a project-wide search for "MOCK:" surfaces exactly Track B's
# scope. Keeping these groups accurate is part of that.
#
# Never commit real values. Copy to .env.local (git-ignored).

# ============================================================================
# TRACK A.5 — solo
# ============================================================================

# --- LLM provider -----------------------------------------------------------
# Replaces the canned AI responses in the Assistant, Document Canvas, AI
# Reports and Digest. The source-attribution chips on AI output become a real
# retrieval step at the same time (BUILD_PLAN.md §6).
ANTHROPIC_API_KEY=
LLM_MODEL=

# --- Database ---------------------------------------------------------------
# Fixture JSON → a real multi-tenant schema. Tenant isolation becomes a real
# architectural concern here, not just a {{CLIENT_LOGO}} token. Track B reviews
# that isolation later; it does not build it.
DATABASE_URL=

# --- Auth & session ---------------------------------------------------------
# Track A has no authentication at all. Track A.5 adds real authentication,
# sessions, and the role-based access the UI already assumes — the 5 staff
# ranks plus client and admin.
#
# This is also where the forced-password-change-on-first-login decision lands
# for staff provisioning (BUILD_PLAN.md §3.1): either it gets built here, or it
# gets consciously skipped and carried into HANDOFF.md.
AUTH_SECRET=
AUTH_URL=

# ============================================================================
# TRACK B — dev team
# ============================================================================

# --- Email & calendar -------------------------------------------------------
# MOCK: integrations currently show as already "connected" in fixture data —
# there is no OAuth flow in Track A (BUILD_PLAN.md §5). Reading a user's mail
# is a sensitive scope and typically triggers a provider security review.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=

# --- Meetings ---------------------------------------------------------------
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
MS_TEAMS_CLIENT_ID=
MS_TEAMS_CLIENT_SECRET=

# --- E-signature ------------------------------------------------------------
ESIGN_PROVIDER=
ESIGN_API_KEY=
ESIGN_WEBHOOK_SECRET=

# --- Payments ---------------------------------------------------------------
PAYMENT_PROVIDER=
PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# ============================================================================
# TRACK A — now
# ============================================================================

# --- Demo deployment --------------------------------------------------------
# BUILD_PLAN.md §1: Vercel, password-protected, so a brand-carrying but
# unfinished product is not exposed publicly. §1 offered a choice between
# Vercel's built-in protection and a middleware gate; this is the middleware
# gate, so the login screen can be bilingual and look like the product.
#
# Set it in the Vercel project's Environment Variables, never in a committed
# file. Read only on the server — middleware and one Server Action — so it
# never reaches the browser bundle, and the cookie the gate sets holds a
# SHA-256 of it rather than the value.
#
# The gate is OFF in development: `npm run dev` needs nothing here. A
# production build FAILS CLOSED — with no password set it refuses every route
# rather than serving them, and the login screen says so.
#
# See lib/demo-gate.ts and middleware.ts.
DEMO_ACCESS_PASSWORD=
